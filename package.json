					"default": true,
					"description": "%config.review-graph.gerrit.showReviewProgress.description%"
				},
				"review-graph.gerrit.showMetaCommits": {
					"type": "string",
					"enum": [
						"collapsed",
						"expanded",
						"off"
					],
					"default": "collapsed",
					"description": "%config.review-graph.gerrit.showMetaCommits.description%"
				},
				"review-graph.gerrit.statusFilter": {
					"type": "object",
					"default": {},
					"properties": {
						"new": {
							"type": "boolean",
							"title": "%config.review-graph.gerrit.statusFilter.new.title%"
						},
						"merged": {
							"type": "boolean",
							"title": "%config.review-graph.gerrit.statusFilter.merged.title%"
						},
						"abandoned": {
							"type": "boolean",
							"title": "%config.review-graph.gerrit.statusFilter.abandoned.title%"
						},
						"wip": {
							"type": "boolean",
							"title": "%config.review-graph.gerrit.statusFilter.wip.title%"
						}
					},
					"description": "%config.review-graph.gerrit.statusFilter.description%"
				},
				"review-graph.gerrit.showPushButton": {
					"type": "boolean",
					"default": true,
					"description": "%config.review-graph.gerrit.showPushButton.description%"
				},
				"review-graph.pullRequests.enabled": {
					"type": "boolean",
					"default": false,
					"description": "%config.review-graph.pullRequests.enabled.description%"
				},
				"review-graph.stickyHeader": {
					"type": "boolean",
					"default": true,
					"description": "%config.review-graph.stickyHeader.description%"
				},
				"review-graph.tabIconColourTheme": {
					"type": "string",
					"enum": [
						"colour",
						"grey"
					],
					"enumDescriptions": [
						"%config.review-graph.tabIconColourTheme.enumDescription0%",
						"%config.review-graph.tabIconColourTheme.enumDescription1%"
					],
					"default": "colour",
					"description": "%config.review-graph.tabIconColourTheme.description%"
				}
			}
		},
		"menus": {
			"commandPalette": [
				{
					"command": "review-graph.openFile",
					"when": "isInDiffEditor && resourceScheme == review-graph && review-graph:codiconsSupported"
				},
				{
					"command": "review-graph.filterByFile",
					"when": "false"
				}
			],
			"explorer/context": [
				{
					"command": "review-graph.filterByFile",
					"when": "resourceScheme == file && !listMultiSelection",
					"group": "review-graph@1"
				}
			],
			"editor/context": [
				{
					"command": "review-graph.filterByFile",
					"when": "resourceScheme == file",
					"group": "review-graph@1"
				}
			],
			"scm/resourceState/context": [
				{
					"command": "review-graph.filterByFile",
					"when": "!listMultiSelection",
					"group": "review-graph@1"
				}
			],
			"editor/title": [
				{
					"command": "review-graph.openFile",
					"group": "navigation",
					"when": "isInDiffEditor && resourceScheme == review-graph && review-graph:codiconsSupported"
				}
			],
			"scm/title": [
				{
					"when": "scmProvider == git && config.review-graph.sourceCodeProviderIntegrationLocation == 'Inline'",
					"command": "review-graph.view",
					"group": "navigation"
				},
				{
					"when": "scmProvider == git && config.review-graph.sourceCodeProviderIntegrationLocation == 'More Actions'",
					"command": "review-graph.view",
					"group": "inline"
				},
				{
					"when": "scmProvider == git",
					"command": "review-graph.amendLastCommit",
					"group": "review-graph@1"
				},
				{
					"when": "scmProvider == git",
					"command": "review-graph.resetCurrentBranchToRemote",
					"group": "review-graph@2"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"clean": "node ./.vscode/clean.js",
		"compile": "npm run lint && npm run clean && npm run compile-src && npm run compile-web",
		"compile-src": "tsc -p ./src && node ./.vscode/package-src.js",
		"compile-web": "tsc -p ./web && node ./.vscode/package-web.js",
		"compile-web-debug": "tsc -p ./web && node ./.vscode/package-web.js debug",
		"lint": "eslint -c .eslintrc.json --max-warnings 0 --ext .ts ./src ./tests ./web",
		"package": "vsce package",
		"package-and-install": "npm run package && node ./.vscode/install-package.js",
		"test": "jest --verbose",
		"test-and-report-coverage": "jest --verbose --coverage"
	},
	"dependencies": {
		"iconv-lite": "0.5.0"
	},
	"devDependencies": {
		"@types/babel__core": "7.1.18",
		"@types/babel__traverse": "7.14.2",
		"@types/iconv-lite": "^0.0.1",
		"@types/jest": "26.0.19",
		"@types/node": "^8.10.62",
		"@types/prettier": "<2.6.0",
		"@types/vscode": "1.38.0",
		"@typescript-eslint/eslint-plugin": "4.10.0",
		"@typescript-eslint/parser": "4.10.0",
		"@vscode/vsce": "^2.19.0",
		"eslint": "7.15.0",
		"jest": "26.6.3",
		"ts-jest": "26.4.4",
		"typescript": "4.0.2",
		"uglify-js": "3.10.0"
	}
}
