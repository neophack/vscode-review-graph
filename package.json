{
	"name": "review-graph",
	"displayName": "%displayName%",
	"version": "1.38.8",
	"publisher": "aucneon",
	"author": {
		"name": "aucneon"
	},
	"description": "%extension.description%",
	"keywords": [
		"git",
		"graph",
		"visualise",
		"diff",
		"action"
	],
	"categories": [
		"Other"
	],
	"homepage": "https://github.com/neophack/vscode-review-graph",
	"repository": {
		"type": "git",
		"url": "https://github.com/neophack/vscode-review-graph"
	},
	"bugs": {
		"url": "https://github.com/neophack/vscode-review-graph/issues"
	},
	"qna": "https://github.com/neophack/vscode-review-graph/issues",
	"license": "SEE LICENSE IN LICENSE",
	"icon": "resources/icon.png",
	"engines": {
		"vscode": "^1.38.0"
	},
	"extensionKind": [
		"workspace"
	],
	"activationEvents": [
		"onCommand:review-graph.view",
		"onCommand:review-graph.filterByFile",
		"onCommand:review-graph.version",
		"onCommand:review-graph.searchCommits",
		"workspaceContains:.git"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"category": "Review Graph",
				"command": "review-graph.view",
				"title": "%command.review-graph.view.title%",
				"icon": {
					"light": "resources/review-graph-cmd-icon-light.svg",
					"dark": "resources/review-graph-cmd-icon-dark.svg"
				}
			},
			{
				"category": "Review Graph",
				"command": "review-graph.addGitRepository",
				"title": "%command.review-graph.addGitRepository.title%"
			},
			{
				"category": "Review Graph",
				"command": "review-graph.clearAvatarCache",
				"title": "%command.review-graph.clearAvatarCache.title%"
			},
			{
				"category": "Review Graph",
				"command": "review-graph.endAllWorkspaceCodeReviews",
				"title": "%command.review-graph.endAllWorkspaceCodeReviews.title%"
			},
			{
				"category": "Review Graph",
				"command": "review-graph.endSpecificWorkspaceCodeReview",
				"title": "%command.review-graph.endSpecificWorkspaceCodeReview.title%"
			},
			{
				"category": "Review Graph",
				"command": "review-graph.fetch",
				"title": "%command.review-graph.fetch.title%"
			},
			{
				"category": "Review Graph",
				"command": "review-graph.removeGitRepository",
				"title": "%command.review-graph.removeGitRepository.title%"
			},
			{
				"category": "Review Graph",
				"command": "review-graph.resumeWorkspaceCodeReview",
				"title": "%command.review-graph.resumeWorkspaceCodeReview.title%"
			},
			{
				"category": "Review Graph",
				"command": "review-graph.exportCodeReviewState",
				"title": "%command.review-graph.exportCodeReviewState.title%"
			},
			{
				"category": "Review Graph",
				"command": "review-graph.importCodeReviewState",
				"title": "%command.review-graph.importCodeReviewState.title%"
			},
			{
				"category": "Review Graph",
				"command": "review-graph.version",
				"title": "%command.review-graph.version.title%"
			},
			{
				"category": "Review Graph",
				"command": "review-graph.searchCommits",
				"title": "%command.review-graph.searchCommits.title%"
			},
			{
				"category": "Review Graph",
				"command": "review-graph.filterByFile",
				"title": "%command.review-graph.filterByFile.title%"
			},
			{
				"category": "Review Graph",
				"command": "review-graph.openFile",
				"title": "%command.review-graph.openFile.title%",
				"icon": "$(go-to-file)",
				"enablement": "isInDiffEditor && resourceScheme == review-graph && review-graph:codiconsSupported"
			},
			{
				"category": "Review Graph",
				"command": "review-graph.amendLastCommit",
				"title": "%command.review-graph.amendLastCommit.title%",
				"icon": "$(edit)"
			},
			{
				"category": "Review Graph",
				"command": "review-graph.resetCurrentBranchToRemote",
				"title": "%command.review-graph.resetCurrentBranchToRemote.title%",
				"icon": "$(discard)"
			}
		],
		"configuration": {
			"type": "object",
			"title": "%config.title%",
			"properties": {
				"review-graph.commitDetailsView.autoCenter": {
					"type": "boolean",
					"default": true,
					"description": "%config.review-graph.commitDetailsView.autoCenter.description%"
				},
				"review-graph.commitDetailsView.fileView.fileTree.compactFolders": {
					"type": "boolean",
					"default": true,
					"description": "%config.review-graph.commitDetailsView.fileView.fileTree.compactFolders.description%"
				},
				"review-graph.commitDetailsView.fileView.type": {
					"type": "string",
					"enum": [
						"File Tree",
						"File List"
					],
					"enumDescriptions": [
						"%config.review-graph.commitDetailsView.fileView.type.enumDescription0%",
						"%config.review-graph.commitDetailsView.fileView.type.enumDescription1%"
					],
					"default": "File Tree",
					"description": "%config.review-graph.commitDetailsView.fileView.type.description%"
				},
				"review-graph.commitDetailsView.location": {
					"type": "string",
					"enum": [
						"Inline",
						"Docked to Bottom"
					],
					"enumDescriptions": [
						"%config.review-graph.commitDetailsView.location.enumDescription0%",
						"%config.review-graph.commitDetailsView.location.enumDescription1%"
					],
					"default": "Inline",
					"description": "%config.review-graph.commitDetailsView.location.description%"
				},
				"review-graph.contextMenuActionsVisibility": {
					"type": "object",
					"default": {},
					"properties": {
						"branch": {
							"type": "object",
							"properties": {
								"checkout": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.branch.checkout.title%"
								},
								"rename": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.branch.rename.title%"
								},
								"createBranch": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.branch.createBranch.title%"
								},
								"delete": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.branch.delete.title%"
								},
								"merge": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.branch.merge.title%"
								},
								"rebase": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.branch.rebase.title%"
								},
								"push": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.branch.push.title%"
								},
								"pull": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.branch.pull.title%"
								},
								"viewIssue": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.branch.viewIssue.title%"
								},
								"createPullRequest": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.branch.createPullRequest.title%"
								},
								"createArchive": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.branch.createArchive.title%"
								},
								"selectInBranchesDropdown": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.branch.selectInBranchesDropdown.title%"
								},
								"unselectInBranchesDropdown": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.branch.unselectInBranchesDropdown.title%"
								},
								"copyName": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.branch.copyName.title%"
								}
							}
						},
						"commit": {
							"type": "object",
							"properties": {
								"addTag": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commit.addTag.title%"
								},
								"createBranch": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commit.createBranch.title%"
								},
								"checkout": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commit.checkout.title%"
								},
								"cherrypick": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commit.cherrypick.title%"
								},
								"revert": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commit.revert.title%"
								},
								"drop": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commit.drop.title%"
								},
								"merge": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commit.merge.title%"
								},
								"rebase": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commit.rebase.title%"
								},
								"reset": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commit.reset.title%"
								},
								"copyHash": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commit.copyHash.title%"
								},
								"copySubject": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commit.copySubject.title%"
								}
							}
						},
						"commitDetailsViewFile": {
							"type": "object",
							"properties": {
								"viewDiff": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commitDetailsViewFile.viewDiff.title%"
								},
								"viewFileAtThisRevision": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commitDetailsViewFile.viewFileAtThisRevision.title%"
								},
								"viewDiffWithWorkingFile": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commitDetailsViewFile.viewDiffWithWorkingFile.title%"
								},
								"openFile": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commitDetailsViewFile.openFile.title%"
								},
								"markAsReviewed": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commitDetailsViewFile.markAsReviewed.title%"
								},
								"markAsNotReviewed": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commitDetailsViewFile.markAsNotReviewed.title%"
								},
								"resetFileToThisRevision": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commitDetailsViewFile.resetFileToThisRevision.title%"
								},
								"copyAbsoluteFilePath": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commitDetailsViewFile.copyAbsoluteFilePath.title%"
								},
								"copyRelativeFilePath": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.commitDetailsViewFile.copyRelativeFilePath.title%"
								}
							}
						},
						"remoteBranch": {
							"type": "object",
							"properties": {
								"checkout": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.remoteBranch.checkout.title%"
								},
								"delete": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.remoteBranch.delete.title%"
								},
								"fetch": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.remoteBranch.fetch.title%"
								},
								"merge": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.remoteBranch.merge.title%"
								},
								"pull": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.remoteBranch.pull.title%"
								},
								"createBranch": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.remoteBranch.createBranch.title%"
								},
								"viewIssue": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.remoteBranch.viewIssue.title%"
								},
								"createPullRequest": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.remoteBranch.createPullRequest.title%"
								},
								"createArchive": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.remoteBranch.createArchive.title%"
								},
								"selectInBranchesDropdown": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.remoteBranch.selectInBranchesDropdown.title%"
								},
								"unselectInBranchesDropdown": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.remoteBranch.unselectInBranchesDropdown.title%"
								},
								"copyName": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.remoteBranch.copyName.title%"
								}
							}
						},
						"stash": {
							"type": "object",
							"properties": {
								"apply": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.stash.apply.title%"
								},
								"createBranch": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.stash.createBranch.title%"
								},
								"pop": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.stash.pop.title%"
								},
								"drop": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.stash.drop.title%"
								},
								"copyName": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.stash.copyName.title%"
								},
								"copyHash": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.stash.copyHash.title%"
								}
							}
						},
						"tag": {
							"type": "object",
							"properties": {
								"viewDetails": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.tag.viewDetails.title%"
								},
								"delete": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.tag.delete.title%"
								},
								"push": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.tag.push.title%"
								},
								"createArchive": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.tag.createArchive.title%"
								},
								"copyName": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.tag.copyName.title%"
								}
							}
						},
						"uncommittedChanges": {
							"type": "object",
							"properties": {
								"stash": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.uncommittedChanges.stash.title%"
								},
								"reset": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.uncommittedChanges.reset.title%"
								},
								"clean": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.uncommittedChanges.clean.title%"
								},
								"openSourceControlView": {
									"type": "boolean",
									"title": "%config.review-graph.contextMenuActionsVisibility.uncommittedChanges.openSourceControlView.title%"
								}
							}
						}
					},
					"markdownDescription": "%config.review-graph.contextMenuActionsVisibility.markdownDescription%"
				},
				"review-graph.customBranchGlobPatterns": {
					"type": "array",
					"items": {
						"type": "object",
						"title": "%config.review-graph.customBranchGlobPatterns.items.title%",
						"required": [
							"name",
							"glob"
						],
						"properties": {
							"name": {
								"type": "string",
								"title": "%config.review-graph.customBranchGlobPatterns.items.name.title%",
								"description": "%config.review-graph.customBranchGlobPatterns.items.name.description%"
							},
							"glob": {
								"type": "string",
								"title": "%config.review-graph.customBranchGlobPatterns.items.glob.title%",
								"description": "%config.review-graph.customBranchGlobPatterns.items.glob.description%"
							}
						}
					},
					"default": [],
					"description": "%config.review-graph.customBranchGlobPatterns.description%"
				},
				"review-graph.customEmojiShortcodeMappings": {
					"type": "array",
					"items": {
						"type": "object",
						"title": "%config.review-graph.customEmojiShortcodeMappings.items.title%",
						"required": [
							"shortcode",
							"emoji"
						],
						"properties": {
							"shortcode": {
								"type": "string",
								"title": "%config.review-graph.customEmojiShortcodeMappings.items.shortcode.title%",
								"description": "%config.review-graph.customEmojiShortcodeMappings.items.shortcode.description%"
							},
							"emoji": {
								"type": "string",
								"title": "%config.review-graph.customEmojiShortcodeMappings.items.emoji.title%",
								"description": "%config.review-graph.customEmojiShortcodeMappings.items.emoji.description%"
							}
						}
					},
					"default": [],
					"description": "%config.review-graph.customEmojiShortcodeMappings.description%"
				},
				"review-graph.customPullRequestProviders": {
					"type": "array",
					"items": {
						"type": "object",
						"title": "%config.review-graph.customPullRequestProviders.items.title%",
						"required": [
							"name",
							"templateUrl"
						],
						"properties": {
							"name": {
								"type": "string",
								"title": "%config.review-graph.customPullRequestProviders.items.name.title%",
								"description": "%config.review-graph.customPullRequestProviders.items.name.description%"
							},
							"templateUrl": {
								"type": "string",
								"title": "%config.review-graph.customPullRequestProviders.items.templateUrl.title%",
								"markdownDescription": "%config.review-graph.customPullRequestProviders.items.templateUrl.markdownDescription%"
							}
						}
					},
					"default": [],
					"markdownDescription": "%config.review-graph.customPullRequestProviders.markdownDescription%"
				},
				"review-graph.avatars.gitlabToken": {
					"type": "string",
					"default": "",
					"description": "%config.review-graph.avatars.gitlabToken.description%"
				},
				"review-graph.date.format": {
					"type": "string",
					"enum": [
						"Date & Time",
						"Date Only",
						"ISO Date & Time",
						"ISO Date Only",
						"Relative"
					],
					"enumDescriptions": [
						"%config.review-graph.date.format.enumDescription0%",
						"%config.review-graph.date.format.enumDescription1%",
						"%config.review-graph.date.format.enumDescription2%",
						"%config.review-graph.date.format.enumDescription3%",
						"%config.review-graph.date.format.enumDescription4%"
					],
					"default": "Date & Time",
					"description": "%config.review-graph.date.format.description%"
				},
				"review-graph.date.type": {
					"type": "string",
					"enum": [
						"Author Date",
						"Commit Date"
					],
					"enumDescriptions": [
						"%config.review-graph.date.type.enumDescription0%",
						"%config.review-graph.date.type.enumDescription1%"
					],
					"default": "Author Date",
					"description": "%config.review-graph.date.type.description%"
				},
				"review-graph.defaultColumnVisibility": {
					"type": "object",
					"properties": {
						"Date": {
							"type": "boolean",
							"title": "%config.review-graph.defaultColumnVisibility.Date.title%"
						},
						"Author": {
							"type": "boolean",
							"title": "%config.review-graph.defaultColumnVisibility.Author.title%"
						},
						"Commit": {
							"type": "boolean",
							"title": "%config.review-graph.defaultColumnVisibility.Commit.title%"
						}
					},
					"default": {
						"Date": true,
						"Author": true,
						"Commit": true
					},
					"description": "%config.review-graph.defaultColumnVisibility.description%"
				},
				"review-graph.dialog.addTag.pushToRemote": {
					"type": "boolean",
					"default": false,
					"description": "%config.review-graph.dialog.addTag.pushToRemote.description%"
				},
				"review-graph.dialog.addTag.type": {
					"type": "string",
					"enum": [
						"Annotated",
						"Lightweight"
					],
					"default": "Annotated",
					"description": "%config.review-graph.dialog.addTag.type.description%"
				},
				"review-graph.dialog.applyStash.reinstateIndex": {
					"type": "boolean",
					"default": false,
					"description": "%config.review-graph.dialog.applyStash.reinstateIndex.description%"
				},
				"review-graph.dialog.cherryPick.noCommit": {
					"type": "boolean",
					"default": false,
					"description": "%config.review-graph.dialog.cherryPick.noCommit.description%"
				},
				"review-graph.dialog.cherryPick.recordOrigin": {
					"type": "boolean",
					"default": false,
					"description": "%config.review-graph.dialog.cherryPick.recordOrigin.description%"
				},
				"review-graph.dialog.createBranch.checkOut": {
					"type": "boolean",
					"default": false,
					"description": "%config.review-graph.dialog.createBranch.checkOut.description%"
				},
				"review-graph.dialog.deleteBranch.forceDelete": {
					"type": "boolean",
					"default": false,
					"description": "%config.review-graph.dialog.deleteBranch.forceDelete.description%"
				},
				"review-graph.dialog.fetchIntoLocalBranch.forceFetch": {
					"type": "boolean",
					"default": false,
					"description": "%config.review-graph.dialog.fetchIntoLocalBranch.forceFetch.description%"
				},
				"review-graph.dialog.fetchRemote.prune": {
					"type": "boolean",
					"default": false,
					"description": "%config.review-graph.dialog.fetchRemote.prune.description%"
				},
				"review-graph.dialog.fetchRemote.pruneTags": {
					"type": "boolean",
					"default": false,
					"description": "%config.review-graph.dialog.fetchRemote.pruneTags.description%"
				},
				"review-graph.dialog.general.referenceInputSpaceSubstitution": {
					"type": "string",
					"enum": [
						"None",
						"Hyphen",
						"Underscore"
					],
					"enumDescriptions": [
